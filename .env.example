# Copy to .env.local and fill in. Never commit .env.local.

# The canonical origin. Used for metadataBase, canonicals, sitemap and OG image URLs.
# Wrong value here means every share card points at the wrong host.
NEXT_PUBLIC_SITE_URL=https://nationalcharitycake.org

# --- Google Sheets ------------------------------------------------------------
# Create a service account, download the JSON key, then share the spreadsheet with
# the service account's email address as an Editor. Without that share step the
# API returns 403 even with valid credentials.
#
# Tabs the app expects, with these exact names:
#   Donations · Partners · Volunteers · InKind · Media · Ledger
#
# Ledger columns, in order (row 1 is headers, data starts at row 2):
#   A id · B date (ISO) · C direction (in|out) · D amount (naira, decimal)
#   E description · F category (donation|grant|programme|logistics|admin)
#   G reference · H proofUrl
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n escapes, wrapped in double quotes.
GOOGLE_PRIVATE_KEY=""

# --- Payments -----------------------------------------------------------------
# The hosted Paystack/Flutterwave checkout URL. While this is empty, /donate says
# so plainly instead of rendering a button that goes nowhere.
NEXT_PUBLIC_CHECKOUT_URL=
